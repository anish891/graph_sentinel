# GraphSentinel AI — configuration template.
# Copy to `.env` and fill in values. NEVER commit `.env`.
# Every value here is a placeholder.

# ---- Application ----------------------------------------------------------
# development | test | demo | production
APP_ENV=development
# Offline demo mode: allows the deterministic mock LLM and demo authentication.
DEMO_MODE=true
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Authentication -------------------------------------------------------
# demo  = synthetic users, signed session cookie (NOT production authentication)
# oidc  = validate bearer JWTs from your identity provider
AUTH_MODE=demo
# Signing key for demo session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_MINUTES=480
# OIDC (only when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
DEFAULT_TENANT=acme

# ---- FalkorDB ---------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=replace-with-a-local-falkordb-password
FALKORDB_GRAPH_NAME=graphsentinel
FALKORDB_QUERY_TIMEOUT_MS=5000

# ---- Relational metadata (SQLite: audit log, approvals, investigation traces)
SQLITE_PATH=./data/runtime/graphsentinel.db

# ---- LLM provider -----------------------------------------------------------
# auto  = Azure OpenAI if fully configured, else Groq if GROQ_API_KEY is set,
#         else the offline mock planner (only if DEMO_MODE=true)
# azure | groq = require that provider
# mock  = deterministic offline planner (clearly labelled as mock everywhere)
LLM_PROVIDER=auto
# Verify whichever provider is configured with: make check-llm

# ---- Groq (OpenAI-compatible; free tier works for testing) -------------------
# Only the key is required. Get one at https://console.groq.com/keys
GROQ_API_KEY=
# A Groq chat model that supports tool use and is available to your key (make check-llm lists them).
# qwen/qwen3.8-27b completed full investigations in testing; openai/gpt-oss-* tended to fail the final step.
GROQ_MODEL=qwen/qwen3.8-27b
# Tool output sent back to the model is trimmed to this many characters per step
# (Groq rejects requests above your per-minute token limit with HTTP 413).
GROQ_TOOL_OUTPUT_MAX_CHARS=1500
# Output tokens requested per turn (counted against the per-minute budget) and reasoning
# effort for openai/gpt-oss-* models.
GROQ_MAX_OUTPUT_TOKENS=1000
GROQ_REASONING_EFFORT=low

# ---- Azure OpenAI (LLM only; nothing is deployed to Azure) ---------------------
# All three values are required to make calls: the key, the endpoint it belongs to,
# and the deployment (model) name. Get them from whoever issued the key.
# Verify with: make check-llm
AZURE_OPENAI_API_KEY=
# e.g. https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# "v1" uses the GA /openai/v1/ API surface (recommended). A dated version such
# as 2025-04-01-preview uses the classic api-version query parameter instead.
AZURE_OPENAI_API_VERSION=v1
# The *deployment name* the model is served under (not necessarily the model name).
AZURE_OPENAI_DEPLOYMENT=
# auto | responses | chat — auto tries the Responses API, then falls back to
# Chat Completions with tool calling.
AZURE_OPENAI_API_MODE=auto
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ---- Agent limits -------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TRAVERSAL_DEPTH=5
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_INVESTIGATION_TIMEOUT_SECONDS=480
AGENT_TOKEN_BUDGET=80000
AGENT_MAX_CONCURRENT_INVESTIGATIONS=4
AGENT_REQUIRE_APPROVAL=true

# ---- Actions --------------------------------------------------------------------
ACTION_APPROVAL_TTL_HOURS=24

# ---- HTTP hardening -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BYTES=65536

# ---- Observability (optional) ---------------------------------------------------
# OTLP/HTTP endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- MCP adapter (optional) -----------------------------------------------------
MCP_PRINCIPAL_ROLE=viewer
MCP_ENABLE_WRITE_TOOLS=false
